# Copy to .env and fill in. Set the API key for whichever provider you target.
# Models below default to Anthropic Haiku; flip to any LiteLLM-supported model
# (gpt-4o-mini, deepseek-chat, mistral-small-latest, ollama/llama-3.1, ...).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Default models. The eval ablates across at least two providers — see
# eval/configs/ for the matrix. Haiku is the default cheap+good baseline.
PROSPECTER_MODEL_PARSER=claude-haiku-4-5
PROSPECTER_MODEL_SCORER=claude-haiku-4-5
PROSPECTER_MODEL_FALLBACK=claude-sonnet-4-5

# Examples of swapping providers without code changes:
# PROSPECTER_MODEL_SCORER=gpt-4o-mini
# PROSPECTER_MODEL_SCORER=deepseek/deepseek-chat
# PROSPECTER_MODEL_SCORER=mistral/mistral-small-latest

# Path to the local SIRENE dump (see data/README.md).
PROSPECTER_SIRENE_PATH=data/sirene
